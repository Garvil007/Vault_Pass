DATABASE_URL=postgresql+psycopg2://vaultpass:vaultpass@localhost:5432/vaultpass

# Separate database used ONLY by the pytest suite. MUST be a different database
# from DATABASE_URL so tests never read or wipe dev/prod data. Create it once:
#   CREATE DATABASE vaultpass_test;
DATABASE_URL_TEST=postgresql+psycopg2://vaultpass:vaultpass@localhost:5432/vaultpass_test
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
